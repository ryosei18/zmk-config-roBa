#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&trackball {
    //    automouse-layer = <4>;

    scroll-layers = <3>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };

        btn4 {
            bindings = <&mkp MB4>;
            key-positions = <30 31>;
        };

        btn5 {
            bindings = <&mkp MB5>;
            key-positions = <32 31>;
        };
    };

    behaviors {
        dot_ques: dot_ques {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_QUES";
            bindings = <&kp PERIOD>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comm_ecxl: comm_ecxl {
            compatible = "zmk,behavior-mod-morph";
            label = "COMM_ECXL";
            bindings = <&kp COMMA>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        slsh_bsls: slsh_bsls {
            compatible = "zmk,behavior-mod-morph";
            label = "SLSH_BSLS";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        q_esc: q_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "Q_ESC";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp ESCAPE>;

            tapping-term-ms = <200>;
        };

        lt_enter_fast: lt_enter_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_ENTER_FAST";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        backspac_fast: backspac_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPAC_FAST";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_spac_fast: lt_spac_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SPAC_FAST";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    macros {
        m_alt_tab: m_alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT>, <&macro_press>, <&kp TAB>, <&macro_tap>;

            label = "M_ALT_TAB";
        };

        m_finish: m_finish {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LSHIFT))>, <&macro_release>;

            label = "M_FINISH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&q_esc  &kp W   &kp E   &kp R           &kp T                                                                             &kp Y                   &kp U           &kp I       &kp O      &kp P
&kp A   &kp S   &kp D   &mt LEFT_ALT F  &kp G                  &none                                    &none             &kp H                   &mt LEFT_ALT J  &kp K       &lt 3 L    &mt LEFT_SHIFT LEFT_ALT
&kp Z   &kp X   &kp C   &kp V           &kp B                  &none                                    &none             &kp N                   &kp M           &comm_ecxl  &dot_ques  &kp DELETE
&trans  &trans  &trans  &trans          &lt_spac_fast 1 SPACE  &backspac_fast LEFT_SHIFT BACKSPACE      &kp LEFT_CONTROL  &lt_enter_fast 2 ENTER                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        layer_1 {
            bindings = <
&kp F1       &kp F2         &kp F3          &kp F4            &kp F5                                           &kp SEMICOLON          &kp COLON          &slsh_bsls       &kp LS(GRAVE)     &trans
&kp CARET    &kp HASH       &kp PIPE        &kp AMPERSAND     &kp ASTERISK          &trans      &trans         &kp MINUS              &kp EQUAL          &kp PLUS         &kp SQT           &kp DOLLAR
&kp AT_SIGN  &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &trans      &trans         &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp PERCENT
&trans       &trans         &trans          &trans            &trans                &trans      &kp LS(SPACE)  &kp LEFT_SHIFT                                                               &trans
            >;
        };

        layer_2 {
            bindings = <
&kp F6  &kp F7        &kp F8        &kp F9            &kp F10                                           &trans          &kp PAGE_DOWN   &kp PAGE_UP   &trans           &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &m_alt_tab        &trans          &kp LC(C)              &kp LC(V)  &kp LEFT        &kp DOWN        &kp UP_ARROW  &kp RIGHT        &trans
&trans  &trans        &trans        &kp LEFT_CONTROL  &trans          &kp LC(X)              &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
&trans  &trans        &trans        &trans            &kp LEFT_SHIFT  &kp K_APPLICATION      &trans     &m_finish                                                      &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp N7        &kp N8        &kp N9        &trans                      &bt BT_SEL 0      &bt BT_SEL 1   &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4
&kp N0  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans  &trans      &trans  &kp LEFT_ALT      &kp LG(LS(S))  &kp LA(LC(DEL))  &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &trans  &kp LEFT_CONTROL  &bt BT_CLR     &trans           &trans        &trans
&trans  &trans        &trans        &trans        &trans  &trans      &trans  &trans                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };
    };
};
